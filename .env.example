# Copy to .env.local to override values for local development. Never commit real values.
# An empty value means "not set": the app uses its default, or the feature stays off.

# --- API (Go) ---

# HTTP port of the API.
PORT=8080
# Log level: debug | info | warn | error.
LOG_LEVEL=info

# Library root: the SMB dataset in production (/library); a local folder in development.
LIBRARY_PATH=
# App state (SQLite, image cache, staging, trash, journal). Production: /data; development: a local folder.
DATA_PATH=
# Folder names of the two library roots inside LIBRARY_PATH.
MOVIES_DIR=Movies
SERIES_DIR=TV Shows

# Login: set ONE of the two. The argon2id hash is the recommended one.
APP_PASSWORD_HASH=
# Plain-text alternative. Keep it out of version control.
APP_PASSWORD=
# Random secret that signs the session cookie. Never commit it.
SESSION_SECRET=
# Session lifetime, as a Go duration (for example 720h).
SESSION_TTL=
# true only when the app is served over HTTPS.
COOKIE_SECURE=

# --- Metadata (TMDB, optional) ---

# Without a key the app works with free names. Set the v3 API key or the v4 read token.
# Never sent to the browser.
TMDB_API_KEY=
TMDB_READ_TOKEN=
# Language of the TMDB data; English is the fallback when a translation is missing.
TMDB_LANGUAGE=es-MX

# --- Media servers (optional) ---

# Jellyfin base URL and API key.
JELLYFIN_URL=
JELLYFIN_API_KEY=
# Plex base URL and token.
PLEX_URL=
PLEX_TOKEN=

# --- Files and processing ---

# User and group the app runs as. The dataset ACL must grant them Modify, inherited.
PUID=
PGID=
# Days that trashed items are kept before they are purged.
TRASH_RETENTION_DAYS=30
# Number of extractions that run at the same time.
EXTRACT_CONCURRENCY=
# How often the Unassigned folder is scanned, and how often the whole library (Go durations).
UNASSIGNED_SCAN_INTERVAL=5m
LIBRARY_SCAN_INTERVAL=1h
# Extensions kept as video and as external subtitles (comma separated).
VIDEO_EXTENSIONS=.mkv,.mp4,.avi,.m4v,.ts,.m2ts,.mov,.wmv,.webm,.mpg,.mpeg
SUBTITLE_EXTENSIONS=.srt,.ass,.ssa,.sub,.idx,.vtt

# --- Web (Vite) ---

# http = talk to the Go API (local and production); demo = no backend, simulated in the browser.
VITE_DATA_SOURCE=http
