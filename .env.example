# Copy to .env.local to override values for local development. Never commit real values.
# An empty value means "not set": the app uses its default, or the feature stays off.
# Required (the app does not start without them): LIBRARY_PATH, DATA_PATH, SESSION_SECRET
# and one of APP_PASSWORD_HASH / APP_PASSWORD.

# --- API (Go) ---

# HTTP port of the API.
PORT=8080
# Log level: debug | info | warn | error.
LOG_LEVEL=info

# Required. Library root: the SMB dataset in production (/library); a local folder in development.
LIBRARY_PATH=
# Required. App state (SQLite, image cache, staging, trash, journal). Production: /data; development: a local folder.
DATA_PATH=
# Folder names of the two library roots inside LIBRARY_PATH.
MOVIES_DIR=Movies
SERIES_DIR=TV Shows

# Required: set ONE of the two. The argon2id hash is the recommended one.
# Generate it with: echo 'your password' | task hash-password
# In .env.local wrap it in single quotes, because Compose reads an unquoted $ as a variable:
# APP_PASSWORD_HASH='$argon2id$v=19$...'
APP_PASSWORD_HASH=
# Plain-text alternative. Keep it out of version control.
APP_PASSWORD=
# Required, at least 32 bytes. Random secret that signs the session cookie (for example: openssl rand -hex 32).
# Never commit it.
SESSION_SECRET=
# Session lifetime, as a Go duration.
SESSION_TTL=720h
# true only when the app is served over HTTPS.
COOKIE_SECURE=false

# --- Metadata (TMDB, optional) ---

# Without a key the app works with free names. Set the v3 API key or the v4 read token, not both.
# Never sent to the browser.
TMDB_API_KEY=
TMDB_READ_TOKEN=
# Language of the TMDB data; English is the fallback when a translation is missing.
TMDB_LANGUAGE=es-MX

# --- Media servers (optional) ---

# Jellyfin base URL and API key: set both or neither.
JELLYFIN_URL=
JELLYFIN_API_KEY=

# --- Files and processing ---

# Days that trashed items are kept before they are purged.
TRASH_RETENTION_DAYS=30
# Number of extractions that run at the same time (1 to 8).
EXTRACT_CONCURRENCY=1
# How often the Unassigned folder is scanned, and how often the whole library is (Go durations, 1m or more).
UNASSIGNED_SCAN_INTERVAL=5m
LIBRARY_SCAN_INTERVAL=1h
# Extensions kept as video and as external subtitles (comma separated).
VIDEO_EXTENSIONS=.mkv,.mp4,.avi,.m4v,.ts,.m2ts,.mov,.wmv,.webm,.mpg,.mpeg
SUBTITLE_EXTENSIONS=.srt,.ass,.ssa,.sub,.idx,.vtt

# --- Web (Vite) ---

# http = talk to the Go API (local and production); demo = no backend, simulated in the browser.
VITE_DATA_SOURCE=http
# Development only: where the Vite proxy of /api forwards the requests.
API_PROXY_TARGET=http://localhost:8080
