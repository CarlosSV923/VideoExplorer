{
  "name": "videoexplorer",
  "private": true,
  "description": "Self-hosted web app to upload, extract, classify, rename and organize movies and series so Jellyfin recognizes them.",
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "pnpm --filter @videoexplorer/web dev",
    "build:web": "pnpm --filter @videoexplorer/web build",
    "gen:web": "pnpm --filter @videoexplorer/web gen:api",
    "lint:web": "pnpm --filter @videoexplorer/web lint",
    "typecheck:web": "pnpm --filter @videoexplorer/web typecheck",
    "test:web": "pnpm --filter @videoexplorer/web test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
