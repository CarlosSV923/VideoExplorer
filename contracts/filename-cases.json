  "folders": {
    "description": "Names completed or decided by their folders (RF-20, §5). The folders are relative to the entry; the nearest folder is used, and for episodes the folder above the season folder is the series.",
    "cases": [
      {
        "name": "a season folder and a number name give season and chapter; the series is the folder above",
        "input": { "path": "Breaking Bad/Season 1/01.mkv", "kind": "video" },
