{
  "description": "Naming rules of spec §5, as data for both implementations. Phase 2 pins the title choice: discTitle is the <T> of a movie or series, chapterTitle is the <título cap.> of the file's chapters. original is the TMDB title in the original language (for a chapter, in the series' original language); english is the en-US title. An absent English title is a missing key or an empty string. The sanitizing of spec §5 (steps 1 to 6) is pinned in phase 4 (section `sanitize`). Phase 5 adds the subtitle language (`subtitleLanguage`) and the library paths (`paths`: folders, movie and chapter files, subtitles; a rejected input has `expected.error` with the field). Conservative choices: a title with no letters (digits and signs only) counts as Latin; combining marks are not letters, so a decomposed accent does not make a title non-Latin; a generic title is one of Episode, Episodio, Capítulo, Capitulo or Chapter followed by a number, in any case, whatever the number; the suffix that can be collapsed is ' (N)', ', Part N' or ', Parte N' or a final ' N' (so 'Odisea 2001' and 'Odisea 2002' would share the base 'Odisea'), and the base must not be empty.",
  "discTitle": {
    "description": "Disc title <T>: the original title when all its letters are Latin, else the English title, else the original title. Empty only when both are empty.",
    "cases": [
      {
        "name": "a Latin title with accents and an apostrophe is kept",
        "input": {
          "original": "Le Fabuleux Destin d'Amélie Poulain",
          "english": "Amélie"
        },
        "expected": "Le Fabuleux Destin d'Amélie Poulain"
      },
      {
        "name": "a Latin title without English is kept",
        "input": {
          "original": "The Godfather"
        },
        "expected": "The Godfather"
      },
      {
        "name": "a Latin title is kept even when English exists",
        "input": {
          "original": "Il Padrino",
          "english": "The Godfather"
        },
        "expected": "Il Padrino"
      },
      {
        "name": "a Japanese title takes its English title",
        "input": {
          "original": "千と千尋の神隠し",
          "english": "Spirited Away"
        },
        "expected": "Spirited Away"
      },
      {
        "name": "a Korean title takes its English title",
        "input": {
          "original": "기생충",
          "english": "Parasite"
        },
        "expected": "Parasite"
      },
      {
        "name": "a Russian title takes its English title",
        "input": {
          "original": "Сталкер",
          "english": "Stalker"
        },
        "expected": "Stalker"
      },
      {
        "name": "a non-Latin title without English keeps the original",
        "input": {
          "original": "千と千尋の神隠し"
        },
        "expected": "千と千尋の神隠し"
      },
      {
        "name": "an empty English title counts as absent",
        "input": {
          "original": "Сталкер",
          "english": ""
        },
        "expected": "Сталкер"
      },
      {
        "name": "a mix of Latin and non-Latin letters is not Latin",
        "input": {
          "original": "Tokyo 東京",
          "english": "Tokyo Story"
        },
        "expected": "Tokyo Story"
      },
      {
        "name": "a mix of Latin and non-Latin letters without English keeps the original",
        "input": {
          "original": "Tokyo 東京"
        },
        "expected": "Tokyo 東京"
      },
      {
        "name": "a decomposed accent is still Latin",
        "input": {
          "original": "Café Society",
          "english": "Other"
        },
        "expected": "Café Society"
      },
      {
        "name": "digits and signs only, without English, keep the original",
        "input": {
          "original": "3-2+1"
        },
        "expected": "3-2+1"
      },
      {
        "name": "digits only keep the original even with English",
        "input": {
          "original": "1917",
          "english": "Nineteen Seventeen"
        },
        "expected": "1917"
      }
    ]
  },
  "chapterTitle": {
    "description": "Chapter title <título cap.> of the file's chapters: each chapter takes its original title when that is Latin, else its English title, else nothing (generic titles count as nothing). Several titles are joined with ' + ', except when they all share the same base (the title without a final number, ' (N)' or ', Part N'): then the base is the title. Chapters without title are left out. Empty when no chapter has a title.",
    "cases": [
      {
        "name": "a Latin original title is used",
        "input": {
          "chapters": [{ "original": "Piloto", "english": "Pilot" }]
        },
        "expected": "Piloto"
      },
      {
        "name": "a non-Latin original title takes its English title",
        "input": {
          "chapters": [{ "original": "パイロット", "english": "Pilot" }]
        },
        "expected": "Pilot"
      },
      {
        "name": "a non-Latin original title without English is omitted",
        "input": {
          "chapters": [{ "original": "パイロット" }]
        },
        "expected": ""
      },
      {
        "name": "a chapter without original title uses its English title",
        "input": {
          "chapters": [{ "english": "Pilot" }]
        },
        "expected": "Pilot"
      },
      {
        "name": "a chapter with no title at all is empty",
        "input": {
          "chapters": [{}]
        },
        "expected": ""
      },
      {
        "name": "surrounding spaces are ignored",
        "input": {
          "chapters": [{ "english": "  Pilot  " }]
        },
        "expected": "Pilot"
      },
      {
        "name": "a generic original title counts as no title",
        "input": {
          "chapters": [{ "original": "Episodio 3", "english": "The Finale" }]
        },
        "expected": "The Finale"
      },
      {
        "name": "a generic English title counts as no title",
        "input": {
          "chapters": [{ "original": "第3話", "english": "Episode 3" }]
        },
        "expected": ""
      },
      {
        "name": "generic titles are recognized in any case",
        "input": {
          "chapters": [{ "original": "capítulo 3" }]
        },
        "expected": ""
      },
      {
        "name": "Chapter followed by a number is generic",
        "input": {
          "chapters": [{ "english": "Chapter 12" }]
        },
        "expected": ""
      },
      {
        "name": "a generic word without a number is a real title",
        "input": {
          "chapters": [{ "english": "Episode Zero" }]
        },
        "expected": "Episode Zero"
      },
      {
        "name": "a single chapter keeps its suffix",
        "input": {
          "chapters": [{ "english": "Pilot (1)" }]
        },
        "expected": "Pilot (1)"
      },
      {
        "name": "two Latin titles join with a plus",
        "input": {
          "chapters": [{ "original": "Pilot" }, { "original": "Cat's in the Bag" }]
        },
        "expected": "Pilot + Cat's in the Bag"
      },
      {
        "name": "non-Latin titles join their English titles",
        "input": {
          "chapters": [
            { "original": "パイロット", "english": "Pilot" },
            { "original": "猫は袋の中", "english": "Cat's in the Bag" }
          ]
        },
        "expected": "Pilot + Cat's in the Bag"
      },
      {
        "name": "titles that differ only in (1) and (2) collapse",
        "input": {
          "chapters": [{ "english": "Pilot (1)" }, { "english": "Pilot (2)" }]
        },
        "expected": "Pilot"
      },
      {
        "name": "titles that differ only in ', Part 1' and ', Part 2' collapse",
        "input": {
          "chapters": [{ "english": "The Finale, Part 1" }, { "english": "The Finale, Part 2" }]
        },
        "expected": "The Finale"
      },
      {
        "name": "titles that differ only in a final number collapse",
        "input": {
          "chapters": [{ "english": "Pilot 1" }, { "english": "Pilot 2" }]
        },
        "expected": "Pilot"
      },
      {
        "name": "a title with a suffix collapses with the same title without it",
        "input": {
          "chapters": [{ "english": "The Finale (1)" }, { "english": "The Finale" }]
        },
        "expected": "The Finale"
      },
      {
        "name": "identical titles collapse",
        "input": {
          "chapters": [{ "english": "Pilot" }, { "english": "Pilot" }]
        },
        "expected": "Pilot"
      },
      {
        "name": "titles with different bases are not collapsed",
        "input": {
          "chapters": [{ "english": "Pilot (1)" }, { "english": "Cat's in the Bag (2)" }]
        },
        "expected": "Pilot (1) + Cat's in the Bag (2)"
      },
      {
        "name": "one title that differs in base blocks the collapse of all",
        "input": {
          "chapters": [
            { "english": "Pilot (1)" },
            { "english": "Pilot" },
            { "english": "Cat's in the Bag" }
          ]
        },
        "expected": "Pilot (1) + Pilot + Cat's in the Bag"
      },
      {
        "name": "an empty base is not a base",
        "input": {
          "chapters": [{ "english": "(1)" }, { "english": "(2)" }]
        },
        "expected": "(1) + (2)"
      },
      {
        "name": "a chapter without title is left out of the join",
        "input": {
          "chapters": [{ "original": "Piloto" }, { "original": "Episodio 2" }]
        },
        "expected": "Piloto"
      },
      {
        "name": "a non-Latin chapter without English is left out of the join",
        "input": {
          "chapters": [{ "original": "猫は袋の中" }, { "english": "Pilot" }]
        },
        "expected": "Pilot"
      },
      {
        "name": "no chapter with a title gives an empty title",
        "input": {
          "chapters": [{ "original": "Episodio 1" }, { "original": "第2話" }]
        },
        "expected": ""
      }
    ]
  },
  "sanitize": {
    "description": "Sanitizing of spec §5 (steps 1 to 6) for one path component: a disc title, a chapter title, a tag or the name of an unassigned entry. In this order: NFC; ': ' becomes ' - ' and ':' becomes '-'; '/' and '\\' become '-'; '\"' becomes \"'\"; '?', '*', '<', '>', '|' and the control characters are removed; each block of white space (Unicode White_Space; a tab is a control character and goes in step 5) becomes one space; then the leading spaces and dots, and the trailing spaces and dots, of the whole component are removed (not of each title in it), so a name never starts with a dot (RF-28 hides dot names). An empty expected means nothing is left: the caller uses fallback instead (decision of phase 4, not in spec §5).",
    "fallback": "Sin nombre",
    "cases": [
      {
        "name": "a colon and a space become a dash",
        "input": { "name": "Mission: Impossible" },
        "expected": "Mission - Impossible"
      },
      {
        "name": "a colon without a space becomes a dash",
        "input": { "name": "Mission:Impossible" },
        "expected": "Mission-Impossible"
      },
      {
        "name": "a colon at the start keeps the dash and loses the leading space",
        "input": { "name": ": Start" },
        "expected": "- Start"
      },
      {
        "name": "a question mark is removed and the dots before it stay inside the name",
        "input": { "name": "What If...? (2021)" },
        "expected": "What If... (2021)"
      },
      {
        "name": "a name that ends in dots loses them",
        "input": { "name": "What If...?" },
        "expected": "What If"
      },
      {
        "name": "slashes and backslashes become dashes",
        "input": { "name": "AC/DC\\Live" },
        "expected": "AC-DC-Live"
      },
      {
        "name": "a double quote becomes a single quote",
        "input": { "name": "The \"Best\" Movie" },
        "expected": "The 'Best' Movie"
      },
      {
        "name": "asterisks, angle brackets, pipes and question marks are removed",
        "input": { "name": "A*B<C>D|E?F" },
        "expected": "ABCDEF"
      },
      {
        "name": "control characters, tabs included, are removed",
        "input": { "name": "A\u0001B\tC\u007fD" },
        "expected": "ABCD"
      },
      {
        "name": "a block of spaces becomes one space",
        "input": { "name": "Movie    Night" },
        "expected": "Movie Night"
      },
      {
        "name": "leading and trailing spaces are removed",
        "input": { "name": "  Movie  " },
        "expected": "Movie"
      },
      {
        "name": "trailing dots and spaces are removed",
        "input": { "name": "Movie. . " },
        "expected": "Movie"
      },
      {
        "name": "dots inside a name stay",
        "input": { "name": "Dr. Strangelove" },
        "expected": "Dr. Strangelove"
      },
      {
        "name": "a decomposed accent is composed (NFC)",
        "input": { "name": "Amélie" },
        "expected": "Amélie"
      },
      {
        "name": "a decomposed ñ is composed (NFC)",
        "input": { "name": "Año" },
        "expected": "Año"
      },
      {
        "name": "accents, ñ and ™ are kept",
        "input": { "name": "Año Nuevo™" },
        "expected": "Año Nuevo™"
      },
      {
        "name": "an apostrophe and accents are kept",
        "input": { "name": "Le Fabuleux Destin d'Amélie Poulain" },
        "expected": "Le Fabuleux Destin d'Amélie Poulain"
      },
      {
        "name": "a non-Latin title is kept",
        "input": { "name": "千と千尋の神隠し" },
        "expected": "千と千尋の神隠し"
      },
      {
        "name": "a dot after a suffix is removed",
        "input": { "name": "Movie (2021)." },
        "expected": "Movie (2021)"
      },
      {
        "name": "a non-breaking space is white space",
        "input": { "name": "A  B" },
        "expected": "A B"
      },
      {
        "name": "the steps apply in order: a slash in a colon title",
        "input": { "name": "A/B: C" },
        "expected": "A-B - C"
      },
      {
        "name": "a colon before a question mark",
        "input": { "name": "Who?: Me" },
        "expected": "Who - Me"
      },
      {
        "name": "only signs leave nothing",
        "input": { "name": "?*" },
        "expected": ""
      },
      {
        "name": "a name made of dots leaves nothing",
        "input": { "name": ".." },
        "expected": ""
      },
      {
        "name": "a leading dot is removed: a hidden name",
        "input": { "name": ".hidden" },
        "expected": "hidden"
      },
      {
        "name": "leading dots are removed",
        "input": { "name": "...dots" },
        "expected": "dots"
      },
      {
        "name": "leading dots and spaces are removed",
        "input": { "name": ". .Movie" },
        "expected": "Movie"
      },
      {
        "name": "a name of a single dot leaves nothing",
        "input": { "name": "." },
        "expected": ""
      },
      {
        "name": "a dot inside a name stays",
        "input": { "name": "Dr. Strangelove" },
        "expected": "Dr. Strangelove"
      },
      {
        "name": "an empty name leaves nothing",
        "input": { "name": "" },
        "expected": ""
      },
      {
        "name": "only white space leaves nothing",
        "input": { "name": "   " },
        "expected": ""
      }
    ]
  },
  "subtitleLanguage": {
    "description": "Language <idioma> of a subtitle file's name (spec §5): ISO 639-1 with an optional region, and only the regions Jellyfin 12.2 recognizes (spike, docs/spike-results.md). The regions Jellyfin recognizes stay (pt-BR, pt-PT, fr-CA, zh-TW, es-419). Latin American Spanish regions (es-MX and the other Spanish-speaking countries of Latin America) become es-419. Any other region is dropped, so the name keeps the language only (es-ES becomes es, en-US and en-GB become en, fr-FR becomes fr): a region Jellyfin does not know shows as an undefined language. Conservative choice (not decided by spec §5). The tag is read without regard to case and written as language in lower case and region in upper case. A tag that is not two letters with an optional region or three digits is rejected; expected.error names the field.",
    "cases": [
      {
        "name": "a language without region is kept",
        "input": { "language": "es" },
        "expected": "es"
      },
      {
        "name": "a Japanese language without region is kept",
        "input": { "language": "ja" },
        "expected": "ja"
      },
      {
        "name": "es-419 is kept",
        "input": { "language": "es-419" },
        "expected": "es-419"
      },
      {
        "name": "pt-BR is kept",
        "input": { "language": "pt-BR" },
        "expected": "pt-BR"
      },
      {
        "name": "pt-PT is kept",
        "input": { "language": "pt-PT" },
        "expected": "pt-PT"
      },
      {
        "name": "fr-CA is kept",
        "input": { "language": "fr-CA" },
        "expected": "fr-CA"
      },
      {
        "name": "zh-TW is kept",
        "input": { "language": "zh-TW" },
        "expected": "zh-TW"
      },
      {
        "name": "es-MX becomes es-419",
        "input": { "language": "es-MX" },
        "expected": "es-419"
      },
      {
        "name": "another Latin American Spanish region becomes es-419",
        "input": { "language": "es-AR" },
        "expected": "es-419"
      },
      {
        "name": "es-CO becomes es-419",
        "input": { "language": "es-CO" },
        "expected": "es-419"
      },
      {
        "name": "es-ES becomes es",
        "input": { "language": "es-ES" },
        "expected": "es"
      },
      {
        "name": "en-US becomes en",
        "input": { "language": "en-US" },
        "expected": "en"
      },
      {
        "name": "en-GB becomes en",
        "input": { "language": "en-GB" },
        "expected": "en"
      },
      {
        "name": "a region Jellyfin does not know is dropped",
        "input": { "language": "fr-FR" },
        "expected": "fr"
      },
      {
        "name": "the language is written in lower case",
        "input": { "language": "EN" },
        "expected": "en"
      },
      {
        "name": "the region is written in upper case",
        "input": { "language": "pt-br" },
        "expected": "pt-BR"
      },
      {
        "name": "a Spanish name is rejected",
        "input": { "language": "español" },
        "expected": { "error": "language" }
      },
      {
        "name": "a three-letter code is rejected: the names use ISO 639-1",
        "input": { "language": "spa" },
        "expected": { "error": "language" }
      },
      {
        "name": "an empty tag is rejected",
        "input": { "language": "" },
        "expected": { "error": "language" }
      },
      {
        "name": "an underscore instead of a dash is rejected",
        "input": { "language": "es_MX" },
        "expected": { "error": "language" }
      }
    ]
  },
  "paths": {
    "description": "Library paths of spec §5, as the full path of each case relative to LIBRARY_PATH, with \"/\" separators. input is what a caller has: original and english are the TMDB titles (the disc title <T> is chosen by metadata DiscTitle, and the chapter title by metadata ChapterTitle from the chapters original and english titles); a free title has only its name in original. roots (optional) are MOVIES_DIR and SERIES_DIR, Movies and TV Shows by default. idTag (optional) is the tag [tmdbid-ID] of a linked title and is on by default (RF-45); a free title (tmdbId 0) has no tag. year 0 means unknown and the \" (<A>)\" part is left out (conservative choice, not decided by spec §5). A version is written as \" - <versión>\" and a part as \" - part<N>\" (RF-22: exclusive). Season 0 is Season 00. A name longer than 255 bytes is cut at a character: the chapter title first, then the disc title; the year, the tag, the codes and the version stay (conservative choice: spec §5 says \"recorta su base\", which this reads as the disc title, the only part that can be cut without losing a Jellyfin identifier). A subtitle carries its video as its own input and is named after the video. A rejected input has expected {\"error\": field}, the field of the library name input: title, year, tmdbId, part, version, extension, season, episode, episodeEnd, root, video or language.",
    "cases": [
      {
        "name": "a movie is in its own folder, and its file has the tag too",
        "input": {
          "kind": "movie",
          "original": "Iron Man",
          "year": 2008,
          "tmdbId": 1726,
          "idTag": true,
          "extension": ".mkv"
        },
        "expected": "Movies/Iron Man (2008) [tmdbid-1726]/Iron Man (2008) [tmdbid-1726].mkv"
      },
      {
        "name": "the tag is on by default for a linked title",
        "input": {
          "kind": "movie",
          "original": "Iron Man",
          "year": 2008,
          "tmdbId": 1726,
          "extension": ".mkv"
        },
        "expected": "Movies/Iron Man (2008) [tmdbid-1726]/Iron Man (2008) [tmdbid-1726].mkv"
      },
      {
        "name": "a linked title with the tag removed has no tag in its folder or file",
        "input": {
          "kind": "movie",
          "original": "Iron Man",
          "year": 2008,
          "tmdbId": 1726,
          "idTag": false,
          "extension": ".mkv"
        },
        "expected": "Movies/Iron Man (2008)/Iron Man (2008).mkv"
      },
      {
        "name": "a free title has no tag",
        "input": { "kind": "movie", "original": "Mi película", "year": 2019, "extension": ".mp4" },
        "expected": "Movies/Mi película (2019)/Mi película (2019).mp4"
      },
      {
        "name": "a free title never has the tag, even when the tag is on",
        "input": {
          "kind": "movie",
          "original": "Mi película",
          "year": 2019,
          "idTag": true,
          "extension": ".mp4"
        },
        "expected": "Movies/Mi película (2019)/Mi película (2019).mp4"
      },
      {
        "name": "a non-Latin title takes its English title",
        "input": {
          "kind": "movie",
          "original": "千と千尋の神隠し",
          "english": "Spirited Away",
          "year": 2001,
          "tmdbId": 129,
          "extension": ".mkv"
        },
        "expected": "Movies/Spirited Away (2001) [tmdbid-129]/Spirited Away (2001) [tmdbid-129].mkv"
      },
      {
        "name": "a non-Latin title without English keeps its original title",
        "input": {
          "kind": "movie",
          "original": "千と千尋の神隠し",
          "year": 2001,
          "tmdbId": 129,
          "extension": ".mkv"
        },
        "expected": "Movies/千と千尋の神隠し (2001) [tmdbid-129]/千と千尋の神隠し (2001) [tmdbid-129].mkv"
      },
      {
        "name": "a Latin title keeps its accents and its apostrophe",
        "input": {
          "kind": "movie",
          "original": "Le Fabuleux Destin d'Amélie Poulain",
          "english": "Amélie",
          "year": 2001,
          "tmdbId": 194,
          "extension": ".mkv"
        },
        "expected": "Movies/Le Fabuleux Destin d'Amélie Poulain (2001) [tmdbid-194]/Le Fabuleux Destin d'Amélie Poulain (2001) [tmdbid-194].mkv"
      },
      {
        "name": "a colon in the title becomes a dash",
        "input": {
          "kind": "movie",
          "original": "Mission: Impossible",
          "year": 1996,
          "tmdbId": 954,
          "extension": ".mkv"
        },
        "expected": "Movies/Mission - Impossible (1996) [tmdbid-954]/Mission - Impossible (1996) [tmdbid-954].mkv"
      },
      {
        "name": "quotes and slashes in a free title are sanitized",
        "input": {
          "kind": "movie",
          "original": "The \"Best\"/Worst",
          "year": 2000,
          "extension": ".mkv"
        },
        "expected": "Movies/The 'Best'-Worst (2000)/The 'Best'-Worst (2000).mkv"
      },
      {
        "name": "a title that sanitizes to nothing takes the fallback name",
        "input": { "kind": "movie", "original": "?*", "year": 2008, "extension": ".mkv" },
        "expected": "Movies/Sin nombre (2008)/Sin nombre (2008).mkv"
      },
